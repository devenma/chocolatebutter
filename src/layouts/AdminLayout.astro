---
import "@app/styles/global.css";

export interface Props {
  title: string;
  currentSection: string;
}

const { title, currentSection } = Astro.props as Props;

const navLinks = [
  { href: "/admin", label: "Dashboard", id: "dashboard" },
  { href: "/admin/streaming-platforms", label: "Streaming Platforms", id: "streaming-platforms" },
  { href: "/admin/spotify-artist-links", label: "Spotify Links", id: "spotify-artist-links" },
  { href: "/admin/social-links", label: "Social Links", id: "social-links" },
  { href: "/admin/featured-link", label: "Featured Link", id: "featured-link" },
  { href: "/admin/uploads", label: "Uploads", id: "uploads" },
];
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Admin — ChocolateButter</title>
  </head>
  <body class="h-full font-sans bg-neutral-950 text-white">
    <!-- Hamburger toggle (mobile only) -->
    <button
      id="sidebar-toggle"
      class="fixed top-4 left-4 z-50 md:hidden bg-neutral-800 border border-purple-500/10 p-2 rounded-lg text-white hover:bg-neutral-700 cursor-pointer"
    >
      <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Backdrop (mobile only) -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-black/50 z-30 hidden md:hidden"></div>

    <div class="flex h-full">
      <!-- Sidebar -->
      <nav
        id="admin-sidebar"
        class="fixed md:static -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out z-40 h-full w-64 bg-neutral-900/95 md:bg-neutral-900/80 backdrop-blur-md border-r border-purple-500/10 p-4 flex flex-col shrink-0"
      >
        <div class="mb-6">
          <a href="/admin" class="text-lg font-bold text-purple-400 hover:text-purple-300 transition-colors">
            🍫 Admin
          </a>
        </div>
        <ul class="space-y-1 flex-1">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`block px-3 py-2 rounded-lg transition-colors ${
                  currentSection === link.id
                    ? "bg-purple-600/20 text-purple-300 font-medium"
                    : "text-neutral-400 hover:text-white hover:bg-neutral-800/50"
                }`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="pt-4 border-t border-purple-500/10">
          <form method="POST" action="/api/admin/logout">
            <button
              type="submit"
              class="w-full px-3 py-2 text-sm text-red-400 hover:text-red-300 hover:bg-red-900/20 rounded-lg transition-colors text-left cursor-pointer"
            >
              Logout
            </button>
          </form>
          <a
            href="/"
            class="block px-3 py-2 mt-1 text-sm text-neutral-500 hover:text-neutral-400 rounded-lg transition-colors"
            target="_blank"
          >
            ← View Site
          </a>
        </div>
      </nav>

      <!-- Main content -->
      <main class="flex-1 overflow-auto p-4 md:p-8 pt-16 md:pt-0">
        <h1 class="text-2xl font-bold mb-6">{title}</h1>
        <slot />
      </main>
    </div>

    <script>
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const toggleBtn = document.getElementById('sidebar-toggle');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        sidebar?.classList.add('translate-x-0');
        backdrop?.classList.remove('hidden');
        menuIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      }

      function closeSidebar() {
        sidebar?.classList.remove('translate-x-0');
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
        menuIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }

      toggleBtn?.addEventListener('click', () => {
        if (sidebar?.classList.contains('translate-x-0')) {
          closeSidebar();
        } else {
          openSidebar();
        }
      });

      backdrop?.addEventListener('click', closeSidebar);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSidebar();
      });
    </script>
  </body>
</html>

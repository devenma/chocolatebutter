---
import svgLoader from "@app/utils/svgLoader";
import { getStreamingPlatforms, seedIfEmpty } from "@app/lib/publicData";

function isAbsoluteUrl(value: string) {
  return /^https?:\/\//i.test(value);
}

await seedIfEmpty();
const streamingPlatforms = await getStreamingPlatforms();
---

<div id="streamingPlatforms" class="md:grid gap-6">
  {
    streamingPlatforms.map((platform) => {
      const { title, url, icon } = platform;

      const isRemote = icon ? isAbsoluteUrl(icon) : false;
      const svgContent =
        !isRemote && icon ? svgLoader.getSvgContent(icon) : null;

      return (
        <div data-platform-id={title}>
          <a
            href={url}
            target="_blank"
            class="w-full max-md:pr-12 md:gap-4 flex md:flex-col justify-center font-semibold not-hover:text-white hover:text-indigo-600 hover:scale-105 hover:shadow-lg shadow-sm relative items-center px-4 py-3 mb-3 bg-neutral-900/10 border border-white/10 hover:border-transparent rounded-2xl hover:bg-neutral-950/50 cursor-pointer transition"
          >
            {svgContent ? (
              <div
                set:html={svgContent}
                class="streaming-platform-icon md:scale-150 md:p-2"
              />
            ) : isRemote ? (
              <img
                src={icon}
                alt={title}
                class="streaming-platform-icon inline-block left-4 size-6 object-contain"
              />
            ) : (
              <span class="inline-block left-4 text-sm">📌</span>
            )}
            <span class="flex-1 text-center text-lg font-medium">{title}</span>
          </a>
        </div>
      );
    })
  }
</div>

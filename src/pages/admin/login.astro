---
import AdminLayout from "@app/layouts/AdminLayout.astro";

const error = Astro.url.searchParams.get("error");
---

<AdminLayout title="Login" currentSection="login">
  <div class="max-w-sm mx-auto mt-20">
    <div class="bg-neutral-900/50 border border-purple-500/10 rounded-xl p-8">
      <h2 class="text-xl font-bold mb-6 text-center">Admin Login</h2>

      {error && (
        <div class="mb-4 px-4 py-3 bg-red-900/30 border border-red-500/30 rounded-lg text-red-300 text-sm">
          {error}
        </div>
      )}

      <form method="POST" action="/api/admin/login" class="space-y-4">
        <div>
          <label for="password" class="block text-sm font-medium text-neutral-400 mb-1">
            Password
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
            placeholder="Enter admin password"
          />
        </div>

        <button
          type="submit"
          class="w-full px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white font-medium rounded-lg transition-colors cursor-pointer"
        >
          Sign In
        </button>
      </form>
    </div>
  </div>
</AdminLayout>

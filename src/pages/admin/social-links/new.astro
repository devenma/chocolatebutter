---
import AdminLayout from "@app/layouts/AdminLayout.astro";
---

<AdminLayout title="New Social Link" currentSection="social-links">
  <div class="max-w-lg">
    <form method="POST" action="/api/admin/social-links" class="space-y-4">
      <div>
        <label for="title" class="block text-sm font-medium text-neutral-400 mb-1">Title *</label>
        <input type="text" id="title" name="title" required
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="Instagram" />
      </div>

      <div>
        <label for="url" class="block text-sm font-medium text-neutral-400 mb-1">URL *</label>
        <input type="url" id="url" name="url" required
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="https://instagram.com/..." />
      </div>

      <div>
        <label for="img" class="block text-sm font-medium text-neutral-400 mb-1">Icon path *</label>
        <input type="text" id="img" name="img" required
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="/instagram-brands-solid-full.svg" />
        <p class="text-xs text-neutral-500 mt-1">Path to SVG in /public</p>
      </div>

      <div>
        <label for="alt" class="block text-sm font-medium text-neutral-400 mb-1">Alt text *</label>
        <input type="text" id="alt" name="alt" required
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="Follow on Instagram" />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="width" class="block text-sm font-medium text-neutral-400 mb-1">Width</label>
          <input type="number" id="width" name="width" value="32" min="1"
            class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors" />
        </div>
        <div>
          <label for="height" class="block text-sm font-medium text-neutral-400 mb-1">Height</label>
          <input type="number" id="height" name="height" value="32" min="1"
            class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors" />
        </div>
      </div>

      <div>
        <label for="order" class="block text-sm font-medium text-neutral-400 mb-1">Order</label>
        <input type="number" id="order" name="order" value="0" min="0"
          class="w-24 px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors" />
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit"
          class="px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white font-medium rounded-lg transition-colors cursor-pointer">
          Create Link
        </button>
        <a href="/admin/social-links"
          class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 rounded-lg transition-colors">
          Cancel
        </a>
      </div>
    </form>
  </div>
</AdminLayout>

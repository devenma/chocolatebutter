---
import AdminLayout from "@app/layouts/AdminLayout.astro";
import { getKv } from "@app/lib/db";

const { id } = Astro.params;
const kv = await getKv();
const entry = await kv.get(["links", "socialLinks", id!]);
const link = entry.value as {
  id: string;
  url: string;
  img: string;
  title: string;
  alt: string;
  width: number;
  height: number;
  order: number;
} | null;

if (!link) {
  return Astro.redirect("/admin/social-links");
}
---

<AdminLayout title="Edit Social Link" currentSection="social-links">
  <div class="max-w-lg">
    <form method="POST" action="/api/admin/social-links" class="space-y-4">
      <input type="hidden" name="_method" value="PUT" />
      <input type="hidden" name="id" value={link.id} />

      <div>
        <label
          for="title"
          class="block text-sm font-medium text-neutral-400 mb-1">Title *</label
        >
        <input
          type="text"
          id="title"
          name="title"
          required
          value={link.title}
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
        />
      </div>

      <div>
        <label for="url" class="block text-sm font-medium text-neutral-400 mb-1"
          >URL *</label
        >
        <input
          type="url"
          id="url"
          name="url"
          required
          value={link.url}
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
        />
      </div>

      <div>
        <label for="img" class="block text-sm font-medium text-neutral-400 mb-1"
          >Icon path *</label
        >
        <div class="flex gap-2 items-start">
          <input
            type="text"
            id="img"
            name="img"
            required
            value={link.img}
            class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors flex-1"
          />
          <button
            type="button"
            class="file-picker-btn px-3 py-2 bg-neutral-700 hover:bg-neutral-600 text-white text-sm rounded-lg transition-colors cursor-pointer whitespace-nowrap"
            >Browse</button
          >
        </div>
      </div>

      <div>
        <label for="alt" class="block text-sm font-medium text-neutral-400 mb-1"
          >Alt text *</label
        >
        <input
          type="text"
          id="alt"
          name="alt"
          required
          value={link.alt}
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
        />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label
            for="width"
            class="block text-sm font-medium text-neutral-400 mb-1">Width</label
          >
          <input
            type="number"
            id="width"
            name="width"
            value={link.width}
            min="1"
            class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          />
        </div>
        <div>
          <label
            for="height"
            class="block text-sm font-medium text-neutral-400 mb-1"
            >Height</label
          >
          <input
            type="number"
            id="height"
            name="height"
            value={link.height}
            min="1"
            class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          />
        </div>
      </div>

      <div>
        <label
          for="order"
          class="block text-sm font-medium text-neutral-400 mb-1">Order</label
        >
        <input
          type="number"
          id="order"
          name="order"
          value={link.order}
          min="0"
          class="w-24 px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
        />
      </div>

      <div class="flex gap-3 pt-2">
        <button
          type="submit"
          class="px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white font-medium rounded-lg transition-colors cursor-pointer"
        >
          Save Changes
        </button>
        <a
          href="/admin/social-links"
          class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 rounded-lg transition-colors"
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { FilePicker } from "@app/components/admin/FilePicker.client.js";
  document.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("img");
    if (input) FilePicker.attach(input, { label: "Icon path" });
  });
</script>

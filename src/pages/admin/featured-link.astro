---
import AdminLayout from "@app/layouts/AdminLayout.astro";
import { getKv } from "@app/lib/db";

const kv = await getKv();
const entry = await kv.get(["meta", "featuredLink"]);
const featured = entry.value as { title: string; url: string; coverImage: string; description: string } | null;

const message = Astro.url.searchParams.get("message");
const error = Astro.url.searchParams.get("error");
---

<AdminLayout title="Featured Link" currentSection="featured-link">
  <div class="max-w-lg">
    {message && (
      <div class="mb-4 px-4 py-3 bg-green-900/30 border border-green-500/30 rounded-lg text-green-300 text-sm">
        {message}
      </div>
    )}
    {error && (
      <div class="mb-4 px-4 py-3 bg-red-900/30 border border-red-500/30 rounded-lg text-red-300 text-sm">
        {error}
      </div>
    )}

    <form method="POST" action="/api/admin/featured-link" class="space-y-4">
      <input type="hidden" name="_method" value="PUT" />

      <div>
        <label for="title" class="block text-sm font-medium text-neutral-400 mb-1">Title *</label>
        <input type="text" id="title" name="title" required value={featured?.title || ""}
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="My Latest Release" />
      </div>

      <div>
        <label for="url" class="block text-sm font-medium text-neutral-400 mb-1">URL *</label>
        <input type="url" id="url" name="url" required value={featured?.url || ""}
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="https://open.spotify.com/album/..." />
      </div>

      <div>
        <label for="coverImage" class="block text-sm font-medium text-neutral-400 mb-1">Cover Image path *</label>
        <input type="text" id="coverImage" name="coverImage" required value={featured?.coverImage || ""}
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="/uploads/my-cover.jpg" />

      </div>

      <div>
        <label for="description" class="block text-sm font-medium text-neutral-400 mb-1">Description</label>
        <textarea id="description" name="description" rows={3}
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="Description of the featured project or release">{featured?.description || ""}</textarea>
      </div>

      <div class="pt-2">
        <button type="submit"
          class="px-6 py-2 bg-purple-600 hover:bg-purple-500 text-white font-medium rounded-lg transition-colors cursor-pointer">
          Save Featured Link
        </button>
      </div>
    </form>

    <!-- Upload area -->
    <div class="mt-10 border-t border-purple-500/10 pt-8">
      <h3 class="text-lg font-semibold mb-4">Upload Image</h3>
      <form method="POST" action="/api/admin/upload" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label for="file" class="block text-sm font-medium text-neutral-400 mb-1">
            Select image (PNG, JPG, WebP, SVG — max 5 MB)
          </label>
          <input type="file" id="file" name="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" required
            class="w-full text-white file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-purple-600 file:text-white hover:file:bg-purple-500 file:cursor-pointer cursor-pointer" />
        </div>
        <button type="submit"
          class="px-4 py-2 bg-neutral-700 hover:bg-neutral-600 text-white font-medium rounded-lg transition-colors text-sm cursor-pointer">
          Upload
        </button>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { FilePicker } from "@app/components/admin/FilePicker.client.js";
  document.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("coverImage");
    if (input) FilePicker.attach(input, { label: "Cover Image" });
  });
</script>

---
import AdminLayout from "@app/layouts/AdminLayout.astro";
import { getKv } from "@app/lib/db";

const kv = await getKv();
const entries = await Array.fromAsync(
  kv.list({ prefix: ["links", "streamingPlatforms"] }),
);
const platforms = entries
  .map((e) => e.value as { id: string; title: string; icon: string; url: string; description: string; order: number })
  .sort((a, b) => a.order - b.order);
---

<AdminLayout title="Streaming Platforms" currentSection="streaming-platforms">
  <div class="mb-4">
    <a
      href="/admin/streaming-platforms/new"
      class="inline-block px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white font-medium rounded-lg transition-colors text-sm"
    >
      + New Platform
    </a>
  </div>

  {platforms.length === 0 ? (
    <p class="text-neutral-500">No streaming platforms yet. Create one!</p>
  ) : (
    <div class="overflow-x-auto rounded-lg border border-purple-500/10">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-neutral-900/80 text-neutral-400">
            <th class="px-4 py-3 text-left font-medium">Order</th>
            <th class="px-4 py-3 text-left font-medium">Title</th>
            <th class="px-4 py-3 text-left font-medium">URL</th>
            <th class="px-4 py-3 text-left font-medium">Icon</th>
            <th class="px-4 py-3 text-right font-medium">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-purple-500/10">
          {platforms.map((platform) => (
            <tr class="hover:bg-neutral-900/50 transition-colors">
              <td class="px-4 py-3 text-neutral-500">{platform.order}</td>
              <td class="px-4 py-3 font-medium">{platform.title}</td>
              <td class="px-4 py-3 text-purple-400 max-w-xs truncate">
                <a href={platform.url} target="_blank" class="hover:underline">{platform.url}</a>
              </td>
              <td class="px-4 py-3 text-neutral-400 font-mono text-xs">{platform.icon}</td>
              <td class="px-4 py-3 text-right">
                <a
                  href={`/admin/streaming-platforms/${platform.id}`}
                  class="text-purple-400 hover:text-purple-300 mr-3 transition-colors"
                >
                  Edit
                </a>
                <form method="POST" action="/api/admin/streaming-platforms" class="inline">
                  <input type="hidden" name="_method" value="DELETE" />
                  <input type="hidden" name="id" value={platform.id} />
                  <button
                    type="submit"
                    class="text-red-400 hover:text-red-300 transition-colors cursor-pointer"
                    onclick="return confirm('Delete {platform.title}?')"
                  >
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>

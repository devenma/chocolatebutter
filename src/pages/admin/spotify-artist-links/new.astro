---
import AdminLayout from "@app/layouts/AdminLayout.astro";
---

<AdminLayout title="New Spotify Artist Link" currentSection="spotify-artist-links">
  <div class="max-w-lg">
    <form method="POST" action="/api/admin/spotify-artist-links" class="space-y-4">
      <div>
        <label for="title" class="block text-sm font-medium text-neutral-400 mb-1">Title *</label>
        <input type="text" id="title" name="title" required
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="Artist Name" />
      </div>

      <div>
        <label for="url" class="block text-sm font-medium text-neutral-400 mb-1">URL *</label>
        <input type="url" id="url" name="url" required
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="https://open.spotify.com/artist/..." />
      </div>

      <div>
        <label for="img" class="block text-sm font-medium text-neutral-400 mb-1">Image path *</label>
        <div class="flex gap-2 items-start">
          <input type="text" id="img" name="img" required
            class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors flex-1"
            placeholder="/ChocolateButter.webp" />
          <button type="button" class="file-picker-btn px-3 py-2 bg-neutral-700 hover:bg-neutral-600 text-white text-sm rounded-lg transition-colors cursor-pointer whitespace-nowrap mt-6">Browse</button>
        </div>
      </div>

      <div>
        <label for="description" class="block text-sm font-medium text-neutral-400 mb-1">Description</label>
        <textarea id="description" name="description" rows={2}
          class="w-full px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white placeholder-neutral-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors"
          placeholder="Brief description"></textarea>
      </div>

      <div>
        <label for="order" class="block text-sm font-medium text-neutral-400 mb-1">Order</label>
        <input type="number" id="order" name="order" value="0" min="0"
          class="w-24 px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-white focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors" />
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit"
          class="px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white font-medium rounded-lg transition-colors cursor-pointer">
          Create Link
        </button>
        <a href="/admin/spotify-artist-links"
          class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 rounded-lg transition-colors">
          Cancel
        </a>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { FilePicker } from "@app/components/admin/FilePicker.client.js";
  document.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("img");
    if (input) FilePicker.attach(input, { label: "Image path" });
  });
</script>
